# ============================================================
# CashSurvive Backend Environment Configuration
# ============================================================

# Host and Port
HOST=0.0.0.0
PORT=8000

# CORS: Comma-separated list of allowed frontend origins (e.g. React/Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Connection (SQLite default for hackathon development)
DATABASE_URL=sqlite:///./cashsurvive.db

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
